+use super::accounts::{
+    FakeAccountStore, FakeProviderAdmin, account_record, accounts_service_with_probe, events,
+};
+use futures::future::BoxFuture;
+use gateway_admin::model::{AdminErrorKind, poolguard::PoolGuardProbe};
+use gateway_core::{
+    account::ProviderAccountId,
+    engine::probe::{AccountProbe, AccountProbeError, AccountProbeRequest, AccountProbeResult},
+    error::{GatewayError, GatewayErrorKind},
+    event::FinishReason,
+    operation::Operation,
+    routing::{RuntimeSnapshot, UpstreamModelId},
+};
+use std::sync::Arc;
+
+struct AnswerProbe {
+    answer: Option<String>,
+    finish_reason: Option<FinishReason>,
+}
+impl AccountProbe for AnswerProbe {
+    fn probe(
+        &self,
+        request: AccountProbeRequest,
+        _: Option<Arc<RuntimeSnapshot>>,
+    ) -> BoxFuture<'_, Result<AccountProbeResult, AccountProbeError>> {
+        assert_eq!(request.account_id.as_str(), "acct_test");
+        assert_eq!(request.upstream_model.as_str(), "test-model");
+        let Operation::Generate(operation) = request.operation else {
+            panic!("expected generation");
+        };
+        assert_eq!(
+            operation.protocol_payload().body()["input"],
+            "17 * 24? Return digits only."
+        );
+        assert!(!operation.protocol_payload().body().contains_key("answer"));
+        Box::pin(async {
+            match &self.answer {
+                Some(answer) => Ok(AccountProbeResult {
+                    text: vec![answer.clone()],
+                    finish_reason: self.finish_reason,
+                }),
+                None => Err(GatewayError::new(GatewayErrorKind::RateLimited, "limited").into()),
+            }
+        })
+    }
+}
+
+#[tokio::test]
+async fn poolguard_custom_prompt_targets_disabled_account_and_returns_complete_answer() {
+    let provider = FakeProviderAdmin::new("openai", events());
+    let mut account = account_record("openai");
+    account.enabled = false;
+    let store = FakeAccountStore::with_account(account, events());
+    let services = accounts_service_with_probe(
+        provider,
+        store,
+        Arc::new(AnswerProbe {
+            answer: Some("408".to_owned()),
+            finish_reason: Some(FinishReason::Stop),
+        }),
+    )
+    .await;
+    let result = services
+        .accounts()
+        .poolguard_probe(request())
+        .await
+        .unwrap();
+    assert_eq!(result.text, "408");
+    assert_eq!(result.control_version, 7);
+}
+
+#[tokio::test]
+async fn poolguard_empty_and_failed_answers_are_errors_not_incorrect_answers() {
+    for answer in [None, Some(String::new()), Some("x".repeat(65537))] {
+        let provider = FakeProviderAdmin::new("openai", events());
+        let store = FakeAccountStore::new("openai", events());
+        let services = accounts_service_with_probe(
+            provider,
+            store,
+            Arc::new(AnswerProbe {
+                answer,
+                finish_reason: Some(FinishReason::Stop),
+            }),
+        )
+        .await;
+        let result = services.accounts().poolguard_probe(request()).await;
+        assert!(matches!(result,Err(error) if error.kind()==AdminErrorKind::BadGateway));
+    }
+}
+fn request() -> PoolGuardProbe {
+    PoolGuardProbe {
+        account_id: ProviderAccountId::new("acct_test").unwrap(),
+        model: UpstreamModelId::new("test-model").unwrap(),
+        prompt: "17 * 24? Return digits only.".to_owned(),
+    }
+}
+
+#[tokio::test]
+async fn poolguard_rejects_nonempty_answers_without_normal_completion() {
+    for finish_reason in [
+        None,
+        Some(FinishReason::Length),
+        Some(FinishReason::ContentFilter),
+        Some(FinishReason::ToolCall),
+        Some(FinishReason::Other),
+    ] {
+        let services = accounts_service_with_probe(
+            FakeProviderAdmin::new("openai", events()),
+            FakeAccountStore::new("openai", events()),
+            Arc::new(AnswerProbe {
+                // 即使半截文本恰好匹配标准答案，也不能据此判为通过。
+                answer: Some("408".to_owned()),
+                finish_reason,
+            }),
+        )
+        .await;
+        let result = services.accounts().poolguard_probe(request()).await;
+        assert!(
+            matches!(result, Err(error) if error.kind() == AdminErrorKind::BadGateway),
+            "finish_reason={finish_reason:?}"
+        );
+    }
+}
+
+struct PendingProbe;
+
+impl AccountProbe for PendingProbe {
+    fn probe(
+        &self,
+        _: AccountProbeRequest,
+        _: Option<Arc<RuntimeSnapshot>>,
+    ) -> BoxFuture<'_, Result<AccountProbeResult, AccountProbeError>> {
+        Box::pin(std::future::pending())
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn poolguard_timeout_is_an_error_and_does_not_change_scheduling() {
+    let recorded = events();
+    let services = accounts_service_with_probe(
+        FakeProviderAdmin::new("openai", recorded.clone()),
+        FakeAccountStore::new("openai", recorded.clone()),
+        Arc::new(PendingProbe),
+    )
+    .await;
+    let started = tokio::time::Instant::now();
+    let result = services.accounts().poolguard_probe(request()).await;
+    assert!(matches!(result, Err(error) if error.kind() == AdminErrorKind::BadGateway));
+    assert_eq!(started.elapsed(), std::time::Duration::from_secs(180));
+    assert!(
+        !recorded.lock().unwrap().iter().any(|event| {
+            event.contains("batch_update") || event.contains("account_unavailable")
+        })
+    );
+}
+
+#[tokio::test]
+async fn poolguard_rejects_invalid_prompts_before_calling_upstream() {
+    let services = accounts_service_with_probe(
+        FakeProviderAdmin::new("openai", events()),
+        FakeAccountStore::new("openai", events()),
+        Arc::new(PendingProbe),
+    )
+    .await;
+    for prompt in [" ".to_owned(), "题".repeat(5462)] {
+        let mut input = request();
+        input.prompt = prompt;
+        let result = services.accounts().poolguard_probe(input).await;
+        assert!(matches!(result, Err(error) if error.kind() == AdminErrorKind::Invalid));
+    }
+}

@@ -0,0 +1,117 @@
+//! 隔离的 PoolGuard 用例；复用诊断执行、账号事务、Provider 通知及配置发布。
+
+use super::{map_provider_error, map_store_error, publish_committed};
+use crate::{
+    model::{
+        AdminError, MutationActor, MutationContext,
+        poolguard::{
+            PoolGuardAction, PoolGuardAnswer, PoolGuardControl, PoolGuardProbe, PoolGuardStatus,
+        },
+    },
+    ports::{provider::ProviderAdmin, store::AccountStore},
+};
+use gateway_core::{
+    engine::probe::{AccountProbe, AccountProbeRequest},
+    event::FinishReason,
+    runtime::SnapshotControl,
+};
+use std::time::Duration;
+use uuid::Uuid;
+
+pub(super) async fn probe(
+    accounts: &dyn AccountStore,
+    probe: &dyn AccountProbe,
+    provider: &dyn ProviderAdmin,
+    request: PoolGuardProbe,
+) -> Result<PoolGuardAnswer, AdminError> {
+    if request.prompt.trim().is_empty() || request.prompt.len() > 16 * 1024 {
+        return Err(AdminError::invalid("题目必须为 1–16384 字节"));
+    }
+    // 答题前冻结控制版本；期间的人工启停会使后续自动禁用发生冲突。
+    let before = accounts
+        .poolguard_control(
+            PoolGuardControl {
+                account_id: request.account_id.clone(),
+                operation_id: Uuid::nil(),
+                action: PoolGuardAction::Inspect,
+                expected_control_version: None,
+            },
+            &MutationContext {
+                actor: MutationActor::System,
+                request_id: "poolguard-probe".to_owned(),
+            },
+        )
+        .await
+        .map_err(|error| map_store_error(error, "poolguard control version"))?;
+    let operation = provider
+        .connection_test_operation(&request.model, &request.prompt)
+        .await
+        .map_err(|error| map_provider_error(error, "poolguard probe"))?;
+    let result = tokio::time::timeout(
+        Duration::from_secs(180),
+        probe.probe(
+            AccountProbeRequest {
+                account_id: request.account_id,
+                provider_kind: provider.provider_kind().clone(),
+                upstream_model: request.model,
+                operation,
+            },
+            None,
+        ),
+    )
+    .await
+    .map_err(|_| AdminError::bad_gateway("账号答题超时，不能作为能力不达标"))?
+    .map_err(|error| {
+        tracing::warn!(source = ?error.source(), kind = ?error.kind(), "PoolGuard 账号答题异常");
+        AdminError::bad_gateway("账号答题失败，不能作为能力不达标")
+    })?;
+    // 流结束不等于答案完整：长度截断、过滤、工具调用及未知终态均不参与判分。
+    if result.finish_reason != Some(FinishReason::Stop) {
+        return Err(AdminError::bad_gateway(
+            "账号回答未正常完成，不能作为能力不达标",
+        ));
+    }
+    let size = result
+        .text
+        .iter()
+        .try_fold(0usize, |size, text| size.checked_add(text.len()))
+        .filter(|size| *size <= 64 * 1024)
+        .ok_or_else(|| AdminError::bad_gateway("账号回答超过检测长度限制"))?;
+    let mut text = String::with_capacity(size);
+    for part in result.text {
+        text.push_str(&part);
+    }
+    if text.trim().is_empty() {
+        return Err(AdminError::bad_gateway("账号未返回完整文本答案"));
+    }
+    Ok(PoolGuardAnswer {
+        text,
+        control_version: before.control_version,
+    })
+}
+
+pub(super) async fn control(
+    accounts: &dyn AccountStore,
+    snapshot: &dyn SnapshotControl,
+    provider: &dyn ProviderAdmin,
+    context: &MutationContext,
+    command: PoolGuardControl,
+) -> Result<PoolGuardStatus, AdminError> {
+    let action = command.action;
+    let account_id = command.account_id.clone();
+    let result = accounts
+        .poolguard_control(command, context)
+        .await
+        .map_err(|error| map_store_error(error, "poolguard isolation"))?;
+    if action != PoolGuardAction::Inspect {
+        if !result.enabled {
+            provider.account_unavailable(&account_id).await;
+        }
+        provider
+            .account_facts_changed(std::slice::from_ref(&account_id))
+            .await;
+        // 幂等重试也发布：上次提交后进程可能尚未来得及通知运行时。
+        publish_committed(snapshot, result.config_revision).await?;
+    }
+    Ok(result)
+}

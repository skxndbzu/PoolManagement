+//! PoolGuard 的定向答题与可重试隔离合同，不持有题库或评分规则。
+
+use gateway_core::{account::ProviderAccountId, routing::UpstreamModelId};
+use uuid::Uuid;
+
+use super::Revision;
+
+pub struct PoolGuardProbe {
+    pub account_id: ProviderAccountId,
+    pub model: UpstreamModelId,
+    pub prompt: String,
+}
+
+pub struct PoolGuardAnswer {
+    pub text: String,
+    pub control_version: u64,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PoolGuardAction {
+    Inspect,
+    Disable,
+    Restore,
+}
+
+pub struct PoolGuardControl {
+    pub account_id: ProviderAccountId,
+    pub operation_id: Uuid,
+    pub action: PoolGuardAction,
+    pub expected_control_version: Option<u64>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PoolGuardIsolation {
+    None,
+    Isolated,
+    Restored,
+    Conflict,
+}
+
+pub struct PoolGuardStatus {
+    pub config_revision: Revision,
+    pub control_version: u64,
+    pub enabled: bool,
+    pub state: PoolGuardIsolation,
+}

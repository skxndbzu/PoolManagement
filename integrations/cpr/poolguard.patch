new file mode 100644
index 00000000..a72427ba
--- /dev/null
+++ b/backend/crates/gateway-store/src/postgres/provider_accounts/poolguard.rs
@@ -0,0 +1,99 @@
+//! 复用管理审计作为隔离回执，不占用官方数据库迁移编号或修改账号 schema。
+//!
+//! 审计保留期届满或粗粒度批量启停使归属无法确认时停止自动恢复。
+//! 与现有管理事务统一先锁 runtime_settings，再锁账号，避免人工操作竞态。
+
+use super::{
+    AdminStoreResult, MutationContext, PgPool, Revision, StoreError, StoreResult, admin_revision,
+    admin_store_error, append_admin_audit_event_in_transaction,
+    bump_config_revision_in_transaction, mutation_audit, postgres_unavailable,
+};
+use gateway_admin::model::poolguard::{
+    PoolGuardAction, PoolGuardControl, PoolGuardIsolation, PoolGuardStatus,
+};
+
+pub(super) async fn control(
+    pool: &PgPool,
+    command: PoolGuardControl,
+    context: &MutationContext,
+) -> AdminStoreResult<PoolGuardStatus> {
+    let mut tx = pool.begin().await.map_err(|_| {
+        admin_store_error("poolguard", postgres_unavailable("begin poolguard control"))
+    })?;
+    let result: StoreResult<PoolGuardStatus> = async {
+        let config: i64 = sqlx::query_scalar("select config_revision from runtime_settings where id = 1 for update")
+            .fetch_one(&mut *tx).await.map_err(|_| postgres_unavailable("lock poolguard control"))?;
+        let id = command.account_id.as_str();
+        let (enabled, provider): (bool, String) = sqlx::query_as(
+            "select enabled, provider_kind from provider_accounts where id = $1 for update")
+            .bind(id).fetch_optional(&mut *tx).await
+            .map_err(|_| postgres_unavailable("read poolguard account"))?
+            .ok_or_else(|| StoreError::NotFound { entity: "provider account", id: id.to_owned() })?;
+        // 批量接口不保存逐账号列表，保守地把同 Provider 导入及批量启停也当作版本变化。
+        let version: i64 = sqlx::query_scalar(
+            "select coalesce(max(config_revision), 0) from admin_audit_events
+             where entity_kind = 'provider_account' and entity_ref = any($1)
+               and ('enabled' = any(changed_fields) or action = 'recover')")
+            .bind(vec![id, "provider_accounts", provider.as_str()])
+            .fetch_one(&mut *tx).await.map_err(|_| postgres_unavailable("read account control version"))?;
+        let disable_id = format!("poolguard:{}:disable", command.operation_id);
+        let restore_id = format!("poolguard:{}:restore", command.operation_id);
+        let receipts: Vec<(String, String, i64)> = sqlx::query_as(
+            "select id, entity_ref, config_revision from admin_audit_events where id = any($1)")
+            .bind(vec![&disable_id, &restore_id]).fetch_all(&mut *tx).await
+            .map_err(|_| postgres_unavailable("read poolguard receipt"))?;
+        if receipts.iter().any(|(_, account, _)| account != id) { return Err(conflict(id)); }
+        let disabled_at = receipts.iter().find(|(event, _, _)| event == &disable_id).map(|(_, _, revision)| *revision);
+        let restored_at = receipts.iter().find(|(event, _, _)| event == &restore_id).map(|(_, _, revision)| *revision);
+        let state = if restored_at.is_some_and(|revision| revision == version) && enabled {
+            PoolGuardIsolation::Restored
+        } else if restored_at.is_none() && disabled_at.is_some_and(|revision| revision == version) && !enabled {
+            PoolGuardIsolation::Isolated
+        } else if disabled_at.is_none() && restored_at.is_none() && enabled {
+            PoolGuardIsolation::None
+        } else { PoolGuardIsolation::Conflict };
+        let mut status = PoolGuardStatus {
+            config_revision: admin_revision(revision(config)?).map_err(|_| postgres_unavailable("invalid control revision"))?,
+            control_version: u64::try_from(version).map_err(|_| postgres_unavailable("invalid account version"))?,
+            enabled, state,
+        };
+        let target = match (command.action, state) {
+            (PoolGuardAction::Inspect, _) |
+            (PoolGuardAction::Disable, PoolGuardIsolation::Isolated) |
+            (PoolGuardAction::Restore, PoolGuardIsolation::Restored) => return Ok(status),
+            (PoolGuardAction::Disable, PoolGuardIsolation::None)
+                if command.expected_control_version == Some(status.control_version) => false,
+            (PoolGuardAction::Restore, PoolGuardIsolation::Isolated) => true,
+            _ => return Err(conflict(id)),
+        };
+        if command.operation_id.is_nil() { return Err(conflict(id)); }
+        let committed = bump_config_revision_in_transaction(&mut tx).await?;
+        sqlx::query("update provider_accounts set enabled = $2, updated_at = greatest(now(), updated_at) where id = $1")
+            .bind(id).bind(target).execute(&mut *tx).await
+            .map_err(|_| postgres_unavailable("write poolguard enabled state"))?;
+        let mut audit = mutation_audit(context, if target {"poolguard.restore"} else {"poolguard.disable"},
+            "provider_account", id, vec!["enabled".to_owned()]);
+        audit.id = if target { restore_id } else { disable_id };
+        append_admin_audit_event_in_transaction(&mut tx, audit, committed).await?;
+        status.config_revision = admin_revision(committed).map_err(|_| postgres_unavailable("invalid committed revision"))?;
+        status.control_version = committed.get(); status.enabled = target;
+        status.state = if target { PoolGuardIsolation::Restored } else { PoolGuardIsolation::Isolated };
+        Ok(status)
+    }.await;
+    super::repository::finish_admin_transaction(tx, result, "poolguard account control")
+        .await
+        .map_err(|error| admin_store_error("poolguard", error))
+}
+
+fn conflict(id: &str) -> StoreError {
+    StoreError::Conflict {
+        entity: "poolguard isolation",
+        id: id.to_owned(),
+        kind: crate::ConflictKind::StaleRevision,
+    }
+}
+fn revision(value: i64) -> StoreResult<Revision> {
+    Revision::new(
+        u64::try_from(value).map_err(|_| postgres_unavailable("invalid configuration revision"))?,
+    )
+}

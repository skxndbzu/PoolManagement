@@ -0,0 +1,141 @@
+//! PoolGuard 专用管理入口；保留原有 GET connection-test 的固定题目合同。
+
+use super::{
+    AdminAuth, AdminEnvelope, AdminError, AdminJson, AdminResponse, WireValidationError,
+    map_service_error, map_wire_error, require_account_id,
+};
+use crate::auth::SessionState;
+use axum::{Router, extract::State, http::StatusCode, response::IntoResponse, routing::post};
+use gateway_admin::model::poolguard::{
+    PoolGuardAction, PoolGuardControl, PoolGuardIsolation, PoolGuardProbe,
+};
+use gateway_core::{account::ProviderAccountId, routing::UpstreamModelId};
+use serde::Deserialize;
+use uuid::Uuid;
+
+pub(super) fn router<S>() -> Router<S>
+where
+    S: SessionState + Clone + Send + Sync + 'static,
+{
+    Router::new()
+        .route("/api/admin/accounts/poolguard/probe", post(probe::<S>))
+        .route("/api/admin/accounts/poolguard/control", post(control::<S>))
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct ProbeRequest {
+    account_id: String,
+    model: String,
+    prompt: String,
+}
+
+async fn probe<S>(
+    _auth: AdminAuth,
+    State(state): State<S>,
+    AdminJson(input): AdminJson<ProbeRequest>,
+) -> Result<impl IntoResponse, AdminError>
+where
+    S: SessionState + Send + Sync,
+{
+    require_account_id(&input.account_id, "accountId").map_err(map_wire_error)?;
+    if input.model.trim().is_empty()
+        || input.model.len() > 256
+        || input.model.chars().any(char::is_control)
+    {
+        return Err(map_wire_error(WireValidationError::new("model")));
+    }
+    if input.prompt.trim().is_empty() || input.prompt.len() > 16 * 1024 {
+        return Err(map_wire_error(WireValidationError::new("prompt")));
+    }
+    let answer = state
+        .admin_services()
+        .accounts()
+        .poolguard_probe(PoolGuardProbe {
+            account_id: ProviderAccountId::new(input.account_id.clone())
+                .map_err(|_| map_wire_error(WireValidationError::new("accountId")))?,
+            model: UpstreamModelId::new(input.model.clone())
+                .map_err(|_| map_wire_error(WireValidationError::new("model")))?,
+            prompt: input.prompt,
+        })
+        .await
+        .map_err(map_service_error)?;
+    // 用例已确认正常结束原因；不完整响应返回错误，不进入此成功分支。
+    Ok(AdminResponse::new(
+        StatusCode::OK,
+        AdminEnvelope::ok(serde_json::json!({
+            "accountId": input.account_id, "model": input.model, "text": answer.text,
+            "completed": true, "controlVersion": answer.control_version.to_string(),
+        })),
+    ))
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct ControlRequest {
+    account_id: String,
+    operation_id: String,
+    action: String,
+    expected_control_version: Option<String>,
+}
+
+async fn control<S>(
+    auth: AdminAuth,
+    State(state): State<S>,
+    AdminJson(input): AdminJson<ControlRequest>,
+) -> Result<impl IntoResponse, AdminError>
+where
+    S: SessionState + Send + Sync,
+{
+    require_account_id(&input.account_id, "accountId").map_err(map_wire_error)?;
+    let operation_id = Uuid::parse_str(&input.operation_id)
+        .map_err(|_| map_wire_error(WireValidationError::new("operationId")))?;
+    if operation_id.is_nil() {
+        return Err(map_wire_error(WireValidationError::new("operationId")));
+    }
+    let action = match input.action.as_str() {
+        "inspect" => PoolGuardAction::Inspect,
+        "disable" => PoolGuardAction::Disable,
+        "restore" => PoolGuardAction::Restore,
+        _ => return Err(map_wire_error(WireValidationError::new("action"))),
+    };
+    let expected = input
+        .expected_control_version
+        .as_deref()
+        .map(str::parse::<u64>)
+        .transpose()
+        .map_err(|_| map_wire_error(WireValidationError::new("expectedControlVersion")))?;
+    if (action == PoolGuardAction::Disable) != expected.is_some() {
+        return Err(map_wire_error(WireValidationError::new(
+            "expectedControlVersion",
+        )));
+    }
+    let result = state
+        .admin_services()
+        .accounts()
+        .poolguard_control(
+            &auth.context().mutation_context(),
+            PoolGuardControl {
+                account_id: ProviderAccountId::new(input.account_id.clone())
+                    .map_err(|_| map_wire_error(WireValidationError::new("accountId")))?,
+                operation_id,
+                action,
+                expected_control_version: expected,
+            },
+        )
+        .await
+        .map_err(map_service_error)?;
+    let isolation = match result.state {
+        PoolGuardIsolation::None => "none",
+        PoolGuardIsolation::Isolated => "isolated",
+        PoolGuardIsolation::Restored => "restored",
+        PoolGuardIsolation::Conflict => "conflict",
+    };
+    Ok(AdminResponse::new(
+        StatusCode::OK,
+        AdminEnvelope::ok(serde_json::json!({
+            "accountId": input.account_id, "operationId": input.operation_id, "state": isolation,
+            "enabled": result.enabled, "controlVersion": result.control_version.to_string(),
+        })),
+    ))
+}

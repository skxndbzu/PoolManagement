+
+fn command(
+    id: &str,
+    operation: Uuid,
+    action: PoolGuardAction,
+    version: Option<u64>,
+) -> PoolGuardControl {
+    PoolGuardControl {
+        account_id: ProviderAccountId::new(id).unwrap(),
+        operation_id: operation,
+        action,
+        expected_control_version: version,
+    }
+}
+
+#[tokio::test]
+async fn poolguard_concurrent_isolations_have_one_owner_and_preserve_account_facts() {
+    let Some(db) = TestDatabase::create("poolguard_race").await else {
+        return;
+    };
+    let repo = PgProviderAccountRepository::new(db.pool.clone());
+    for (id, user) in [("acct_guard_a", "user-a"), ("acct_guard_b", "user-b")] {
+        repo.insert_provider_account(account(id, user))
+            .await
+            .unwrap();
+    }
+    let facts = sqlx::query_scalar::<_, serde_json::Value>(
+        "select to_jsonb(a) - 'enabled' - 'updated_at' from provider_accounts a where id = 'acct_guard_a'",
+    ).fetch_one(&db.pool).await.unwrap();
+    let store = admin_account_store(&db.pool);
+    let context = MutationContext {
+        actor: MutationActor::System,
+        request_id: "guard-race".to_owned(),
+    };
+    let first = Uuid::new_v4();
+    let second = Uuid::new_v4();
+    let (a, b) = tokio::join!(
+        store.poolguard_control(
+            command("acct_guard_a", first, PoolGuardAction::Disable, Some(0)),
+            &context
+        ),
+        store.poolguard_control(
+            command("acct_guard_a", second, PoolGuardAction::Disable, Some(0)),
+            &context
+        ),
+    );
+    assert_ne!(a.is_ok(), b.is_ok(), "只能有一个隔离操作成为当前归属");
+    let owner = if a.is_ok() { first } else { second };
+    let other = if a.is_ok() { second } else { first };
+    assert!(
+        store
+            .poolguard_control(
+                command("acct_guard_a", other, PoolGuardAction::Restore, None),
+                &context
+            )
+            .await
+            .is_err()
+    );
+    // 同一操作 ID 不得抢占另一账号，即使其控制版本有效。
+    assert!(
+        store
+            .poolguard_control(
+                command("acct_guard_b", owner, PoolGuardAction::Disable, Some(0)),
+                &context
+            )
+            .await
+            .is_err()
+    );
+    assert!(
+        store
+            .poolguard_control(
+                command("acct_guard_a", owner, PoolGuardAction::Restore, None),
+                &context
+            )
+            .await
+            .unwrap()
+            .enabled
+    );
+    let after = sqlx::query_scalar::<_, serde_json::Value>(
+        "select to_jsonb(a) - 'enabled' - 'updated_at' from provider_accounts a where id = 'acct_guard_a'",
+    ).fetch_one(&db.pool).await.unwrap();
+    assert_eq!(facts, after, "启停不得覆盖凭据、额度及其他账号配置");
+    let untouched: bool =
+        sqlx::query_scalar("select enabled from provider_accounts where id = 'acct_guard_b'")
+            .fetch_one(&db.pool)
+            .await
+            .unwrap();
+    assert!(untouched);
+    db.close().await;
+}
+
+#[tokio::test]
+async fn poolguard_receipts_are_idempotent_and_manual_disable_prevents_restore() {
+    let Some(db) = TestDatabase::create("poolguard_receipts").await else {
+        return;
+    };
+    let repo = PgProviderAccountRepository::new(db.pool.clone());
+    repo.insert_provider_account(account("acct_guard", "guard-user"))
+        .await
+        .unwrap();
+    let store = admin_account_store(&db.pool);
+    let context = MutationContext {
+        actor: MutationActor::System,
+        request_id: "guard-test".to_owned(),
+    };
+    let op = Uuid::new_v4();
+    let before = store
+        .poolguard_control(
+            command("acct_guard", op, PoolGuardAction::Inspect, None),
+            &context,
+        )
+        .await
+        .unwrap();
+    assert_eq!(before.state, PoolGuardIsolation::None);
+    let isolated = store
+        .poolguard_control(
+            command(
+                "acct_guard",
+                op,
+                PoolGuardAction::Disable,
+                Some(before.control_version),
+            ),
+            &context,
+        )
+        .await
+        .unwrap();
+    assert!(!isolated.enabled);
+    let replay = store
+        .poolguard_control(
+            command(
+                "acct_guard",
+                op,
+                PoolGuardAction::Disable,
+                Some(before.control_version),
+            ),
+            &context,
+        )
+        .await
+        .unwrap();
+    assert_eq!(replay.control_version, isolated.control_version);
+    // 额度观测不会改变启停归属，重启后创建的新 Store 也能读取同一回执。
+    sqlx::query("update provider_accounts set updated_at = now() where id = 'acct_guard'")
+        .execute(&db.pool)
+        .await
+        .unwrap();
+    let restored = admin_account_store(&db.pool)
+        .poolguard_control(
+            command("acct_guard", op, PoolGuardAction::Restore, None),
+            &context,
+        )
+        .await
+        .unwrap();
+    assert!(restored.enabled);
+    let replay = store
+        .poolguard_control(
+            command("acct_guard", op, PoolGuardAction::Restore, None),
+            &context,
+        )
+        .await
+        .unwrap();
+    assert_eq!(replay.control_version, restored.control_version);
+    assert!(
+        store
+            .poolguard_control(
+                command(
+                    "acct_guard",
+                    op,
+                    PoolGuardAction::Disable,
+                    Some(restored.control_version)
+                ),
+                &context
+            )
+            .await
+            .is_err()
+    );
+
+    let op = Uuid::new_v4();
+    store
+        .poolguard_control(
+            command(
+                "acct_guard",
+                op,
+                PoolGuardAction::Disable,
+                Some(restored.control_version),
+            ),
+            &context,
+        )
+        .await
+        .unwrap();
+    store
+        .batch_update_accounts(
+            BatchUpdateAccounts {
+                account_ids: vec!["acct_guard".to_owned()],
+                enabled: Some(false),
+                concurrency_limit: None,
+                weight: None,
+                model_access: None,
+                group_ids: None,
+                outbound_proxy: None,
+            },
+            &context,
+        )
+        .await
+        .unwrap();
+    let state = store
+        .poolguard_control(
+            command("acct_guard", op, PoolGuardAction::Inspect, None),
+            &context,
+        )
+        .await
+        .unwrap();
+    assert_eq!(state.state, PoolGuardIsolation::Conflict);
+    assert!(
+        store
+            .poolguard_control(
+                command("acct_guard", op, PoolGuardAction::Restore, None),
+                &context
+            )
+            .await
+            .is_err()
+    );
+    let enabled: bool =
+        sqlx::query_scalar("select enabled from provider_accounts where id = 'acct_guard'")
+            .fetch_one(&db.pool)
+            .await
+            .unwrap();
+    assert!(!enabled);
+    db.close().await;
+}

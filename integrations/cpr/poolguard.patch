+    // 审计过期时宁可保持隔离，不能把缺失记录解释为允许恢复。
+    sqlx::query("delete from admin_audit_events where id = $1")
+        .bind(format!("poolguard:{op}:disable"))
+        .execute(&db.pool)
+        .await
+        .unwrap();
+    let state = store
+        .poolguard_control(
+            command("acct_guard", op, PoolGuardAction::Inspect, None),
+            &context,
+        )
+        .await
+        .unwrap();
+    assert_eq!(state.state, PoolGuardIsolation::Conflict);
+    assert!(
+        store
+            .poolguard_control(
+                command("acct_guard", op, PoolGuardAction::Restore, None),
+                &context
+            )
+            .await
+            .is_err()
